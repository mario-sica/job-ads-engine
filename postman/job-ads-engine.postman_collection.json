    {
      "name": "Revisioni",
      "description": "Le revisioni sono append-only: un edit crea una revisione nuova, un ripristino sposta il puntatore su una esistente.",
      "item": [
        {
          "name": "Storico della variante",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/variants/{{variantId}}/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "variants",
                "{{variantId}}",
                "revisions"
              ]
            },
            "description": "Tutte le revisioni della variante, dalla più recente, con `source` (llm/manual), `model`, `prompt_version`, `input_snapshot`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit manuale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/variants/{{variantId}}/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "variants",
                "{{variantId}}",
                "revisions"
              ]
            },
            "description": "Nuova revisione `manual`, validata con lo schema del formato (422 se non valida).\n\nLo script *Pre-request* legge il contenuto corrente della variante e cambia un campo (headline, CTA, hook o sottotitolo, secondo il formato): il body usa `{{manualContent}}`. Per un edit tuo, sostituisci il body con `{ \"content\": { …contenuto completo… } }`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": {{manualContent}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.collectionVariables.get(\"baseUrl\");",
                  "const adId = pm.collectionVariables.get(\"adId\");",
                  "const variantId = Number(pm.collectionVariables.get(\"variantId\"));",
                  "pm.sendRequest(`${base}/ads/${adId}`, (err, res) => {",
                  "  if (err) throw err;",
                  "  const variant = (res.json().variants || []).find((v) => v.id === variantId);",
                  "  if (!variant) throw new Error(`la variante ${variantId} non appartiene all'annuncio ${adId}: aggiorna le variabili`);",
                  "  const content = variant.current_revision.content;",
                  "  if (content.text && content.text.headline) content.text.headline = \"Headline modificata a mano\";",
                  "  else if (content.text && content.text.cta) content.text.cta = \"CTA modificata a mano\";",
                  "  else if (content.image && content.image.hook) content.image.hook = \"HOOK MODIFICATO A MANO\";",
                  "  else if (content.image && content.image.subtitle) content.image.subtitle = \"sottotitolo modificato a mano\";",
                  "  pm.collectionVariables.set(\"manualContent\", JSON.stringify(content));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const revision = pm.response.json();",
                  "if (revision.id) console.log(`nuova revisione ${revision.id} (${revision.source}); revisionId resta ${pm.collectionVariables.get(\"revisionId\")} per provare il ripristino`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ripristina revisione",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/variants/{{variantId}}/current-revision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "variants",
                "{{variantId}}",
                "current-revision"
              ]
            },
            "description": "Riporta la variante sulla revisione `revisionId` (per default la prima, generata dall'LLM). Non crea copie. 404 se la revisione è di un'altra variante.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"revision_id\": {{revisionId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
